<?xml version="1.0" encoding="utf-8"?>
<!-- ClickOnce kurulumu (setup.exe): kullanıcıya özel, yönetici izni yok, diskten/USB'den kurulum, otomatik güncelleme kapalı.
     Yeni sürümde FileTransit.csproj içindeki Version artırılır; aynı kimlikle daha yüksek sürüm mevcut kurulumu günceller.
     Visual Studio: Sağ tık → Yayımla → Kurulum. Komut satırı: build\publish.ps1 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>artifacts\publish\kurulum\</PublishDir>
    <PublishUrl>artifacts\publish\kurulum\</PublishUrl>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ApplicationVersion>$(Version).0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <IsRevisionIncremented>false</IsRevisionIncremented>
    <ProductName>FileTransit</ProductName>
    <PublisherName>FileTransit</PublisherName>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
    <GenerateManifests>true</GenerateManifests>
    <MapFileExtensions>true</MapFileExtensions>
    <SignManifests>false</SignManifests>
    <SignatureAlgorithm>(none)</SignatureAlgorithm>
    <SkipPublishVerification>false</SkipPublishVerification>
  </PropertyGroup>
</Project>
